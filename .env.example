# GEMINI_API_KEY: Required for server-side Gemini AI API calls only (NEVER expose with VITE_).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Server-only HMAC-SHA256 signing key for HttpOnly session cookies.
# Auto-generated securely on the server if omitted in development.
SESSION_SECRET="CHANGE_ME_STRONG_RANDOM_HEX_SECRET"

# DB_ENCRYPTION_KEY: Server-only key used to derive AES-256-GCM encryption for the local database.
# Auto-generated securely on the server if omitted in development.
DB_ENCRYPTION_KEY="CHANGE_ME_STRONG_RANDOM_HEX_DB_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
